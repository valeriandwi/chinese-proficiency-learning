# docker compose reads this file when it is passed explicitly:
#
#   cp docker/.env.compose.example .env.compose    # then edit
#   docker compose --env-file .env.compose up -d --build
#
# Or skip it entirely and export the same names in your shell — every variable below has a
# working default for a local run. They are HANPATH_*-prefixed so the development `.env`
# (which Compose loads automatically) cannot reconfigure this stack by accident.
#
# Never commit a filled-in copy: .env.compose is git-ignored for exactly that reason.

# --- database ------------------------------------------------------------------
HANPATH_DB_USER=hanpath
HANPATH_DB_PASSWORD=change-me-before-you-expose-this
HANPATH_DB_NAME=hanpath
# Host port published on 127.0.0.1 only, for `make content-import`.
HANPATH_DB_PORT=5435

# --- the app -------------------------------------------------------------------
# development works over plain http. For a TLS-terminating proxy in front, use all three
# production lines together — the config refuses any inconsistent combination.
HANPATH_APP_ENV=development
HANPATH_PUBLIC_BASE_URL=http://localhost:8080
HANPATH_SESSION_COOKIE_SECURE=false
# HANPATH_APP_ENV=production
# HANPATH_PUBLIC_BASE_URL=https://your.domain
# HANPATH_SESSION_COOKIE_SECURE=true

HANPATH_LOG_LEVEL=info
HANPATH_TZ=Asia/Jakarta
HANPATH_WEB_PORT=8080
HANPATH_SMTP_FROM=hanpath <no-reply@your.domain>

# --- optional features ---------------------------------------------------------
# Off unless set: speaking drills stay self-assessed and stay silent about tones.
#   fake -> deterministic pseudo-scores, development and tests only, refused in production
#   azure -> Microsoft Pronunciation Assessment (real phoneme and tone scoring; billed)
HANPATH_SPEECH_PROVIDER=

# --- content import (host side, needs macOS `say`) ------------------------------
# Not read by Compose: these are the values to use when seeding the database from a
# machine that can synthesise audio.
#
#   DATABASE_URL="postgres://hanpath:$HANPATH_DB_PASSWORD@127.0.0.1:5435/hanpath?sslmode=disable" \
#   MEDIA_DIR=./var/media TTS_VOICE=Tingting make content-import
