# hanpath — Caddy: TLS, the built SPA, and the proxy to the API, in one container.
#
# The site address decides the mode, so the same file serves a laptop and a VPS:
#
#   SITE_ADDRESS unset / http://localhost:8080   → plain http on 8080, no TLS attempt
#   SITE_ADDRESS=hanpath.valeriandwi.my.id          → automatic HTTPS (ACME), 80 → 443 redirect
#
# Whatever the mode, the browser only ever sees ONE origin: the SPA at / and the API at /api
# are served by the same host, which is what keeps the session cookie first-party. Caddy
# sets X-Forwarded-For and X-Forwarded-Proto on reverse_proxy by default; the API relies on
# both (rate-limit key, and the Origin check against PUBLIC_BASE_URL).

{$SITE_ADDRESS:http://localhost:8080} {
	encode zstd gzip

	# A learner recording is capped at 1 MiB server-side; this is headroom, not a target.
	request_body {
		max_size 4MB
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# --- the API ---------------------------------------------------------------
	# handle (not handle_path): the path is passed through unchanged, so /api/v1/... stays
	# /api/v1/... and /media/<key> stays /media/<key>.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8081}
	}

	handle /media/* {
		reverse_proxy {$API_UPSTREAM:api:8081}
	}

	handle /healthz {
		reverse_proxy {$API_UPSTREAM:api:8081}
	}

	# --- the SPA ---------------------------------------------------------------
	# Hashed bundle filenames can be cached hard; index.html must not be, or a deploy is
	# invisible until the learner clears the cache.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	handle /hanzi/* {
		header Cache-Control "public, max-age=2592000"
		root * /srv
		file_server
	}

	# Client-side routing: every unknown path is the app, not a 404.
	handle {
		header Cache-Control "no-cache"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
