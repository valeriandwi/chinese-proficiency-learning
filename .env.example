# hanpath — local development environment
# Copy to .env and adjust. Never commit real secrets.

APP_ENV=development
LOG_LEVEL=debug

HTTP_ADDR=127.0.0.1:8081
PUBLIC_BASE_URL=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# The dev database is an isolated LOCAL Postgres cluster on 5435, created and
# started by `make dev-db-up` (data in .local/pgdata, created with --auth=trust, so
# the password below is not checked locally — keep a real one in any shared env).
DATABASE_URL=postgres://hanpath:***@127.0.0.1:5435/hanpath?sslmode=disable

# Redis is optional and unused today: the rate limiter runs in-process, so nothing
# dials this address. Set it when a real cache/session store lands.
# REDIS_ADDR=127.0.0.1:6379

SESSION_COOKIE_NAME=hanpath_session
SESSION_COOKIE_SECURE=false

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=hanpath
S3_SECRET_KEY=hanpath_dev_pw
S3_BUCKET=hanpath-media
S3_USE_PATH_STYLE=true

# With SMTP_ADDR unset, the log transport prints every message (including the
# verification link) instead of losing it. `brew install mailpit` and set this to
# 127.0.0.1:1025 to get a real inbox at http://127.0.0.1:8025.
SMTP_FROM=hanpath <no-reply@hanpath.local>
# SMTP_ADDR=127.0.0.1:1025

# Media assets. Reference audio is generated at import time and served by the API
# from this directory, so the pipeline works with no cloud credentials; S3_* above
# is reserved for when object storage is wanted (a new media.Store implementation).
MEDIA_DIR=./var/media
MEDIA_URL_PREFIX=/media
# TTS_PROVIDER selects how reference audio is obtained at import time:
#   (empty) / say -> macOS `say` + ffmpeg, synthesising anything that is missing
#   existing      -> resolve only the audio already in MEDIA_DIR (a Linux server or a
#                    container, where `say` cannot run); a missing asset fails loudly
#   none          -> no audio at all: importing listening content fails by design
# With TTS_PROVIDER unset and no synthesiser available, contentctl falls back to
# `existing`, which is what lets a server import the curriculum from the committed files.
TTS_VOICE=Tingting
FFMPEG_PATH=ffmpeg

# --- pronunciation scoring (optional) ---------------------------------------
# Empty means the feature is off: speaking drills stay self-assessed and
# POST /recordings answers 503, which the app handles by falling back to the tier-1
# drill. Sending a learner's voice to a third party is opt-in, so nothing here
# defaults to on.
#
#   none  -> off (same as empty)
#   fake  -> deterministic pseudo-scores, development and tests only; refused in
#            production because a fake score shown to a learner is a lie
#   azure -> Microsoft Pronunciation Assessment: real phoneme and tone scoring for
#            Mandarin, per-word detail. Needs a key and a region, is billed per hour
#            of audio, and sends the recording to Microsoft (see docs/sources.md §7)
SPEECH_PROVIDER=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# A recording is a few hundred KB; this is a ceiling on abuse, not a target.
SPEECH_MAX_UPLOAD_BYTES=1048576
# Every scored recording costs money at the provider, so each account has a daily cap.
SPEECH_DAILY_SCORING_CAP=200
