# Build context hygiene. Everything here is either regenerated by the build, needed
# only on the developer's machine, or is the database itself.
.git
.github
.local
graphify-out
bin
var

# Node artefacts: the web image installs from the lockfile and builds from source.
web/node_modules
web/dist
web/.vite
**/node_modules

# The design-system package is fetched, not vendored (design/open-design/.gitignore).
design/open-design

# Local editor / OS noise
.DS_Store
*.log
